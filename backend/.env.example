# ==============================================================================
# DevProfile AI — Backend Environment Configuration Template
# ==============================================================================

GITHUB_TOKEN=


GITHUB_CACHE_TTL_SECONDS=300


GROQ_API_KEY=

GROQ_MODEL=openai/gpt-oss-120b
AI_REQUEST_TIMEOUT_SECONDS=25.0

# ------------------------------------------------------------------------------
# 3. Server & Network Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=12.0
MAX_REPOS_TO_ANALYZE=100


# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/devprofile
DATABASE_URL=sqlite:///./devprofile.db


SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080


GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback

